---
import JourneyStep from '../components/JourneyStep.astro';
import EmptyState from '../components/EmptyState.astro';
import NewsCard from '../components/NewsCard.astro';
import ScheduleRow from '../components/ScheduleRow.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Heading from '../components/Heading.astro';
import Action from '../components/Action.astro';
import Image from '../components/Image.astro';
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import SacramentCard from '../components/SacramentCard.astro';
import { getAllContent } from '../lib/db.js';
const { settings, sacramentos, horarios, avisos } = getAllContent();
---

<Layout
  settings={settings}
  title="Bienvenidos"
  description="Parroquia Apóstol Santiago de Munaypata, La Paz. Conoce los sacramentos, horarios, actividades e información de preinscripciones."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-kicker" data-reveal>
          <span class="sparkle-dot">✳</span> {settings.subtitle.toUpperCase()}{' '}
          <span class="kicker-line"></span> UN HOGAR PARA TODOS
        </div>
        <Heading as="h1" data-reveal>
          {settings.tagline.split(' ').slice(0, -2).join(' ')}{' '}
          <em>{settings.tagline.split(' ').slice(-2).join(' ')}</em>
          <span class="title-period">.</span>
        </Heading>
        <p class="hero-description" data-reveal>
          {settings.heroDescription}
        </p>
        <div class="hero-actions" data-reveal>
          <Action href="/inscripcion" class="btn btn-gold">
            Iniciar preinscripción <Icon name="arrow-up-right" size={19} />
          </Action>
          <Action href="/sacramentos" class="btn btn-ghost-light">
            Explorar sacramentos <Icon name="arrow" size={18} />
          </Action>
        </div>
        <div class="hero-signature" data-reveal>
          <div class="signature-symbol">✝</div>
          <div>
            <strong>Fe que nos une</strong>
            <small>Una historia de encuentro y servicio</small>
          </div>
        </div>
      </div>
      <div class="hero-art" data-reveal>
        <div class="art-ring ring-a"></div>
        <div class="art-ring ring-b"></div>
        {settings.heroImage ? (
          <Image
            class="hero-church hero-custom-photo"
            src={settings.heroImage}
            alt="Fotografía de la parroquia"
          />
        ) : (
          <Image
            class="hero-church"
            src="/templo-ilustracion.svg"
            alt="Ilustración simbólica de un templo católico"
          />
        )}
        <div class="float-sticker sticker-top">
          <span class="sticker-icon">✳</span>
          <div>
            <small>DESDE 1962</small>
            <strong>Una comunidad de fe</strong>
          </div>
        </div>
        <div class="float-sticker sticker-bottom">
          <Icon name="heart" size={22} />
          <div>
            <strong>Tu lugar también está aquí</strong>
            <small>Bienvenidos a casa</small>
          </div>
        </div>
      </div>
    </div>
    <div class="container hero-bottom">
      <span>
        <span class="scroll-line"></span> DESLIZA PARA DESCUBRIR
      </span>
      <span>
        LA PAZ, BOLIVIA <span class="mini-star">✳</span>
      </span>
    </div>
  </section>
  <section class="intro-band">
    <div class="container intro-grid">
      <span class="intro-decoration">✳</span>
      <p>
        Una parroquia, muchas historias. <strong>Un mismo camino de fe.</strong>
      </p>
      <Action href="/contacto">
        Conoce nuestra comunidad <Icon name="arrow-up-right" size={18} />
      </Action>
    </div>
  </section>
  <section class="section section-sacraments" id="sacramentos">
    <div class="container">
      <div class="section-top" data-reveal>
        <div>
          <Eyebrow line>TU CAMINO ESPIRITUAL</Eyebrow>
          <Heading as="h2">
            Momentos que <em>transforman</em> la vida.
          </Heading>
        </div>
        <div class="section-aside">
          <p>
            Te acompañamos en cada etapa de la vida cristiana con orientación y
            cercanía.
          </p>
          <Action class="text-link" href="/sacramentos">
            Ver todos los sacramentos <Icon name="arrow-up-right" size={17} />
          </Action>
        </div>
      </div>
      <div class="sacrament-grid">
        {sacramentos
          .filter((s) => s.featured)
          .slice(0, 4)
          .map((s, i) => (
            <SacramentCard sacrament={s} index={i} />
          ))}
      </div>
    </div>
  </section>
  <section class="section journey-section">
    <div class="container journey-grid">
      <div class="journey-visual" data-reveal>
        <span class="visual-halo"></span>
        <span class="journey-big-cross">✝</span>
        <span class="journey-word">EN COMUNIDAD</span>
        <span class="journey-flower">✳</span>
        <span class="journey-visual-bottom">FE · ESPERANZA · AMOR</span>
      </div>
      <div class="journey-content" data-reveal>
        <Eyebrow line>FÁCIL Y A TU RITMO</Eyebrow>
        <Heading as="h2">
          Tu primer paso <em>es muy sencillo.</em>
        </Heading>
        <p class="section-lede">
          Queremos que el proceso de preinscripción sea claro, humano y sin
          complicaciones.
        </p>
        <div class="steps">
          <JourneyStep number="01" title="Elige tu sacramento">
            Conoce la preparación y los requisitos orientativos.
          </JourneyStep>
          <JourneyStep number="02" title="Completa tus datos">
            Envíanos la información básica de tu solicitud.
          </JourneyStep>
          <JourneyStep number="03" title="Recibe seguimiento">
            Consulta el estado con tu código y la secretaría te orientará.
          </JourneyStep>
        </div>
        <Action href="/inscripcion" class="btn btn-primary">
          Comenzar ahora <Icon name="arrow-up-right" size={19} />
        </Action>
      </div>
    </div>
  </section>
  <section class="section schedule-section">
    <div class="container schedule-grid">
      <div class="schedule-copy" data-reveal>
        <Eyebrow line>ENCUÉNTRANOS</Eyebrow>
        <Heading as="h2">
          Siempre hay un <em>momento para Dios.</em>
        </Heading>
        <p>
          Descubre nuestras celebraciones y actividades. Los horarios deben
          confirmarse antes de asistir.
        </p>
        <Action href="/horarios" class="text-link">
          Consultar todos los horarios <Icon name="arrow-up-right" size={18} />
        </Action>
      </div>
      <div class="schedule-list" data-reveal>
        {horarios.slice(0, 3).map((h) => (
          <ScheduleRow schedule={h} />
        ))}
      </div>
    </div>
  </section>
  <section class="section news-section">
    <div class="container">
      <div class="section-top" data-reveal>
        <div>
          <Eyebrow line>VIDA PARROQUIAL</Eyebrow>
          <Heading as="h2">
            Lo que vivimos <em>juntos.</em>
          </Heading>
        </div>
        <Action href="/vida-parroquial" class="text-link">
          Más avisos y actividades <Icon name="arrow-up-right" size={18} />
        </Action>
      </div>
      <div class="news-grid">
        {avisos.slice(0, 3).map((n, i) => (
          <NewsCard notice={n} index={i} />
        ))}
        {avisos.length === 0 && (
          <EmptyState>
            Pronto compartiremos novedades de nuestra parroquia.
          </EmptyState>
        )}
      </div>
    </div>
  </section>
  <section class="community-cta">
    <div class="container community-cta-inner" data-reveal>
      <div class="cta-cross">✳</div>
      <Eyebrow class="light">ESTAMOS AQUÍ PARA TI</Eyebrow>
      <Heading as="h2">
        Tu historia también <em>es parte de la nuestra.</em>
      </Heading>
      <p>Hay un lugar para ti y tu familia en nuestra comunidad.</p>
      <div class="cta-actions">
        <Action href="/inscripcion" class="btn btn-gold">
          Preinscribirme <Icon name="arrow-up-right" size={19} />
        </Action>
        <Action href="/contacto" class="btn btn-outline-white">
          Hablar con la parroquia
        </Action>
      </div>
    </div>
  </section>
</Layout>
