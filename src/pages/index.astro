---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import SacramentCard from '../components/SacramentCard.astro';
import {getAllContent} from '../lib/db.js';
const {settings,sacramentos,horarios,avisos,eventos}=getAllContent();
---
<Layout settings={settings} title="Bienvenidos" description="Parroquia Apóstol Santiago de Munaypata, La Paz. Conoce los sacramentos, horarios, actividades e información de preinscripciones.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-kicker" data-reveal><span class="sparkle-dot">✳</span> {settings.subtitle.toUpperCase()} <span class="kicker-line"></span> UN HOGAR PARA TODOS</div>
        <h1 data-reveal>{settings.tagline.split(' ').slice(0,-2).join(' ')} <em>{settings.tagline.split(' ').slice(-2).join(' ')}</em><span class="title-period">.</span></h1>
        <p class="hero-description" data-reveal>{settings.heroDescription}</p>
        <div class="hero-actions" data-reveal><a href="/inscripcion" class="btn btn-gold">Iniciar preinscripción <Icon name="arrow-up-right" size={19}/></a><a href="/sacramentos" class="btn btn-ghost-light">Explorar sacramentos <Icon name="arrow" size={18}/></a></div>
        <div class="hero-signature" data-reveal><div class="signature-symbol">✝</div><div><strong>Fe que nos une</strong><small>Una historia de encuentro y servicio</small></div></div>
      </div>
      <div class="hero-art" data-reveal>
        <div class="art-ring ring-a"></div><div class="art-ring ring-b"></div>
        {settings.heroImage ? <img class="hero-church hero-custom-photo" src={settings.heroImage} alt="Fotografía de la parroquia"/> : <img class="hero-church" src="/templo-ilustracion.svg" alt="Ilustración simbólica de un templo católico"/>}
        <div class="float-sticker sticker-top"><span class="sticker-icon">✳</span><div><small>DESDE 1962</small><strong>Una comunidad de fe</strong></div></div>
        <div class="float-sticker sticker-bottom"><Icon name="heart" size={22}/><div><strong>Tu lugar también está aquí</strong><small>Bienvenidos a casa</small></div></div>
      </div>
    </div>
    <div class="container hero-bottom"><span><span class="scroll-line"></span> DESLIZA PARA DESCUBRIR</span><span>LA PAZ, BOLIVIA <span class="mini-star">✳</span></span></div>
  </section>
  <section class="intro-band"><div class="container intro-grid"><span class="intro-decoration">✳</span><p>Una parroquia, muchas historias. <strong>Un mismo camino de fe.</strong></p><a href="/contacto">Conoce nuestra comunidad <Icon name="arrow-up-right" size={18}/></a></div></section>
  <section class="section section-sacraments" id="sacramentos">
    <div class="container">
      <div class="section-top" data-reveal><div><p class="eyebrow"><span class="eyebrow-line"></span> TU CAMINO ESPIRITUAL</p><h2>Momentos que <em>transforman</em> la vida.</h2></div><div class="section-aside"><p>Te acompañamos en cada etapa de la vida cristiana con orientación y cercanía.</p><a class="text-link" href="/sacramentos">Ver todos los sacramentos <Icon name="arrow-up-right" size={17}/></a></div></div>
      <div class="sacrament-grid">{sacramentos.filter(s=>s.featured).slice(0,4).map((s,i)=><SacramentCard sacrament={s} index={i}/>)}</div>
    </div>
  </section>
  <section class="section journey-section">
    <div class="container journey-grid">
      <div class="journey-visual" data-reveal><span class="visual-halo"></span><span class="journey-big-cross">✝</span><span class="journey-word">EN COMUNIDAD</span><span class="journey-flower">✳</span><span class="journey-visual-bottom">FE · ESPERANZA · AMOR</span></div>
      <div class="journey-content" data-reveal><p class="eyebrow"><span class="eyebrow-line"></span> FÁCIL Y A TU RITMO</p><h2>Tu primer paso <em>es muy sencillo.</em></h2><p class="section-lede">Queremos que el proceso de preinscripción sea claro, humano y sin complicaciones.</p>
      <div class="steps">
        <div class="step"><span>01</span><div><h3>Elige tu sacramento</h3><p>Conoce la preparación y los requisitos orientativos.</p></div></div>
        <div class="step"><span>02</span><div><h3>Completa tus datos</h3><p>Envíanos la información básica de tu solicitud.</p></div></div>
        <div class="step"><span>03</span><div><h3>Recibe seguimiento</h3><p>Consulta el estado con tu código y la secretaría te orientará.</p></div></div>
      </div><a href="/inscripcion" class="btn btn-primary">Comenzar ahora <Icon name="arrow-up-right" size={19}/></a></div>
    </div>
  </section>
  <section class="section schedule-section"><div class="container schedule-grid"><div class="schedule-copy" data-reveal><p class="eyebrow"><span class="eyebrow-line"></span> ENCUÉNTRANOS</p><h2>Siempre hay un <em>momento para Dios.</em></h2><p>Descubre nuestras celebraciones y actividades. Los horarios deben confirmarse antes de asistir.</p><a href="/horarios" class="text-link">Consultar todos los horarios <Icon name="arrow-up-right" size={18}/></a></div>
  <div class="schedule-list" data-reveal>{horarios.slice(0,3).map((h)=><div class="schedule-row"><div class="schedule-icon"><Icon name={h.type==='Atención'?'users':h.type==='Catequesis'?'book-open':'calendar'} size={22}/></div><div><h3>{h.title}</h3><p>{h.day} · {h.place}</p></div><strong>{h.time}</strong></div>)}</div></div></section>
  <section class="section news-section"><div class="container"><div class="section-top" data-reveal><div><p class="eyebrow"><span class="eyebrow-line"></span> VIDA PARROQUIAL</p><h2>Lo que vivimos <em>juntos.</em></h2></div><a href="/vida-parroquial" class="text-link">Más avisos y actividades <Icon name="arrow-up-right" size={18}/></a></div>
  <div class="news-grid">{avisos.slice(0,3).map((n,i)=><article class="news-card" data-reveal style={`--stagger:${i*90}ms`}><div class="news-card-art" style={n.image?`background-image:url('${n.image}')`:''}><span class="news-visual-flower">✳</span><span class="news-label">{n.category||'Comunidad'}</span></div><div class="news-card-body"><h3>{n.title}</h3><p>{n.description}</p><a href="/vida-parroquial">Ver novedades <Icon name="arrow-up-right" size={16}/></a></div></article>)}
  {avisos.length===0&&<div class="empty-state">Pronto compartiremos novedades de nuestra parroquia.</div>}</div></div></section>
  <section class="community-cta"><div class="container community-cta-inner" data-reveal><div class="cta-cross">✳</div><p class="eyebrow light">ESTAMOS AQUÍ PARA TI</p><h2>Tu historia también <em>es parte de la nuestra.</em></h2><p>Hay un lugar para ti y tu familia en nuestra comunidad.</p><div class="cta-actions"><a href="/inscripcion" class="btn btn-gold">Preinscribirme <Icon name="arrow-up-right" size={19}/></a><a href="/contacto" class="btn btn-outline-white">Hablar con la parroquia</a></div></div></section>
</Layout>
