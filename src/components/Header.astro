---
import Action from './Action.astro';
import Image from './Image.astro';
import Icon from './Icon.astro';
const { settings, pathname = '/' } = Astro.props;
const links = [
  ['/', 'Inicio'],
  ['/sacramentos', 'Sacramentos'],
  ['/horarios', 'Horarios'],
  ['/vida-parroquial', 'Vida parroquial'],
  ['/contacto', 'Contacto'],
];
---

<div class="topline">
  <div class="container topline-inner">
    <span>
      <Icon name="pin" size={13} /> Munaypata, La Paz · Bolivia
    </span>
    <span class="topline-right">
      <Icon name="heart" size={13} /> Una comunidad abierta para todos
    </span>
  </div>
</div>
<header class="site-header" id="site-header">
  <nav class="container navbar" aria-label="Navegación principal">
    <Action
      class="brand"
      href="/"
      aria-label="Parroquia Apóstol Santiago, inicio"
    >
      <Image
        src={settings.logo || '/emblema.svg'}
        alt="Emblema parroquial"
        width="49"
        height="49"
      />
      <span class="brand-text">
        <strong>{settings.name}</strong>
        <small>{settings.subtitle}</small>
      </span>
    </Action>
    <div class="nav-links" id="main-menu">
      {links.map(([href, label]) => (
        <Action
          class:list={[
            'nav-link',
            {
              active:
                href === '/' ? pathname === '/' : pathname.startsWith(href),
            },
          ]}
          href={href}
          aria-current={
            (href === '/' ? pathname === '/' : pathname.startsWith(href))
              ? 'page'
              : undefined
          }
        >
          {label}
        </Action>
      ))}
      <Action class="nav-cta" href="/inscripcion">
        Preinscribirme <Icon name="arrow-up-right" size={16} />
      </Action>
    </div>
    <Action
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="main-menu"
    >
      <Icon name="menu" size={25} />
    </Action>
  </nav>
</header>
