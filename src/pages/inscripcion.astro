---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Action from '../components/Action.astro';
import Heading from '../components/Heading.astro';
import FormField from '../components/forms/FormField.astro';
import FormHeading from '../components/forms/FormHeading.astro';
import Eyebrow from '../components/Eyebrow.astro';
import WizardProgress from '../components/forms/WizardProgress.astro';
import SacramentOption from '../components/forms/SacramentOption.astro';
import { getAllContent } from '../lib/db.js';
const { settings, sacramentos } = await getAllContent(
  Astro.locals.runtime?.env,
);
const selected = Astro.url.searchParams.get('para') || '';
---

<Layout settings={settings} title="Preinscripción a sacramentos">
  <PageHero
    eyebrow="UN PRIMER PASO CONTIGO"
    title="Preinscripción en línea"
    description="Completa una solicitud inicial y consulta su avance desde cualquier dispositivo. La secretaría confirmará los siguientes pasos."
  />
  <section class="section form-page-section">
    <div class="container registration-layout">
      <div class="form-area" data-reveal>
        {!settings.registrationOpen && (
          <div class="form-alert" role="status">
            <Icon name="circle-help" size={23} />
            <div>
              <strong>Preinscripciones aún no habilitadas</strong>
              <p>
                La parroquia debe validar los requisitos y activar el sistema
                desde su centro de control. Puedes explorar el formulario, pero
                todavía no enviar solicitudes.
              </p>
            </div>
          </div>
        )}
        <FormHeading eyebrow="FORMULARIO DE SOLICITUD">
          <Fragment slot="title">
            Empecemos <em>este camino.</em>
          </Fragment>
          Este formulario es una preinscripción, no una reserva de fecha ni
          confirmación del sacramento.
        </FormHeading>
        <WizardProgress
          steps={['Sacramento', 'Datos personales', 'Confirmar']}
        />
        <form id="register-form" class="form-card" novalidate>
          <section class="form-step" data-step="1">
            <Heading as="h3">¿Qué sacramento deseas solicitar?</Heading>
            <p class="field-intro">
              Selecciona el sacramento para el cual quieres recibir orientación.
            </p>
            <div class="sacrament-options">
              {sacramentos.map((s) => (
                <SacramentOption sacrament={s} selected={selected} />
              ))}
            </div>
          </section>
          <section class="form-step" data-step="2" hidden>
            <Heading as="h3">Cuéntanos un poco de ti</Heading>
            <p class="field-intro">
              Solo solicitamos datos básicos para que la secretaría pueda
              comunicarse.
            </p>
            <div class="fields-grid">
              <FormField
                label="Nombre completo de quien recibirá el sacramento"
                full
                name="name"
                autocomplete="name"
                placeholder="Nombres y apellidos"
                minlength="5"
                maxlength="120"
                required
              />
              <FormField
                label="Edad"
                type="number"
                name="age"
                inputmode="numeric"
                placeholder="Ej. 12"
                min="0"
                max="110"
                required
              />
              <FormField
                label="Teléfono de contacto"
                name="phone"
                type="tel"
                autocomplete="tel"
                inputmode="tel"
                placeholder="Ej. 71234567"
                minlength="7"
                maxlength="20"
                required
              />
              <FormField
                label="Nombre del padre, madre, tutor o responsable"
                full
                name="guardian"
                autocomplete="off"
                placeholder="Nombres y apellidos del responsable"
                minlength="5"
                maxlength="120"
                required
              />
              <FormField
                label="Correo electrónico"
                full
                optional
                name="email"
                type="email"
                autocomplete="email"
                placeholder="correo@ejemplo.com"
                maxlength="120"
              />
              <FormField
                label="Consulta o comentario"
                full
                optional
                multiline
                name="notes"
                rows="3"
                maxlength="800"
                placeholder="¿Hay algo importante que debamos conocer?"
              />
            </div>
          </section>
          <section class="form-step" data-step="3" hidden>
            <Heading as="h3">Revisa y confirma</Heading>
            <p class="field-intro">
              Verifica que los datos sean correctos antes de enviar tu
              solicitud.
            </p>
            <div class="review-box" id="review-box"></div>
            <label class="checkbox-line">
              <input type="checkbox" name="consent" required />
              <span>
                Autorizo a la parroquia a utilizar estos datos exclusivamente
                para gestionar mi solicitud y contactarme sobre la preparación
                sacramental. Soy mayor de edad o responsable del participante.{' '}
                <Action
                  href="/privacidad"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="privacy-link"
                >
                  Leer información de privacidad
                </Action>
                . <strong>*</strong>
              </span>
            </label>
            <input
              type="text"
              name="website"
              autocomplete="off"
              tabindex="-1"
              aria-hidden="true"
              class="honeypot"
            />
          </section>
          <p class="form-feedback" id="form-feedback" role="alert" hidden></p>
          <div class="form-navigation">
            <Action
              type="button"
              class="btn btn-secondary"
              id="previous-step"
              hidden
            >
              <Icon name="arrow-left" size={17} /> Anterior
            </Action>
            <Action type="button" class="btn btn-primary" id="next-step">
              Continuar <Icon name="arrow" size={17} />
            </Action>
            <Action
              type="submit"
              class="btn btn-primary"
              id="submit-registration"
              hidden
              disabled={!settings.registrationOpen}
            >
              Enviar solicitud <Icon name="arrow-up-right" size={17} />
            </Action>
          </div>
        </form>
        <div class="success-card" id="success-card" hidden>
          <span class="success-icon">
            <Icon name="check-circle" size={52} />
          </span>
          <Eyebrow>SOLICITUD RECIBIDA</Eyebrow>
          <Heading as="h2">
            ¡Ya diste el <em>primer paso!</em>
          </Heading>
          <p>
            Guarda el siguiente código y el teléfono que registraste para
            consultar tu estado.
          </p>
          <div class="receipt-code" id="receipt-code"></div>
          <Action type="button" class="copy-button" id="copy-code">
            Copiar código <Icon name="file-text" size={17} />
          </Action>
          <p class="fine-print">
            Este comprobante no confirma una plaza ni una fecha de celebración.
          </p>
          <Action href="/consultar" class="btn btn-primary">
            Consultar estado <Icon name="arrow-up-right" size={17} />
          </Action>
        </div>
      </div>
      <aside class="registration-aside" data-reveal>
        <div class="registration-help">
          <div class="help-icon">
            <Icon name="shield-check" size={29} />
          </div>
          <Heading as="h3">Estamos contigo en cada paso.</Heading>
          <p>
            Tus datos se usarán para organizar tu preinscripción. La preparación
            y los documentos serán validados por la parroquia.
          </p>
          <hr />
          <p>
            <Icon name="check" size={18} /> Solicitud inicial sin compromiso
          </p>
          <p>
            <Icon name="check" size={18} /> Código de seguimiento
          </p>
          <p>
            <Icon name="check" size={18} /> Atención personalizada
          </p>
        </div>
        <div class="registration-questions">
          <Icon name="circle-help" size={24} />
          <Heading as="h4">¿Prefieres hablar directamente?</Heading>
          <p>La secretaría podrá orientarte sobre fechas y documentos.</p>
          <Action href="/contacto">
            Ver cómo contactarnos <Icon name="arrow-up-right" size={17} />
          </Action>
        </div>
      </aside>
    </div>
  </section>
  <script>
    let current = 1;
    const form = document.getElementById('register-form');
    const next = document.getElementById('next-step');
    const previous = document.getElementById('previous-step');
    const submit = document.getElementById('submit-registration');
    const feedback = document.getElementById('form-feedback');
    if (
      form instanceof HTMLFormElement &&
      submit instanceof HTMLButtonElement
    ) {
      function showError(m) {
        feedback.textContent = m;
        feedback.hidden = false;
      }
      function clearError() {
        feedback.hidden = true;
        feedback.textContent = '';
      }
      function validStep() {
        const section = form.querySelector(`[data-step="${current}"]`);
        const fields = [
          ...section.querySelectorAll('input:not(.honeypot),textarea'),
        ];
        if (
          current === 1 &&
          !form.querySelector('input[name="sacrament"]:checked')
        ) {
          showError('Selecciona un sacramento para continuar.');
          return false;
        }
        for (const input of fields)
          if (
            (input instanceof HTMLInputElement ||
              input instanceof HTMLTextAreaElement) &&
            !input.checkValidity()
          ) {
            input.reportValidity();
            return false;
          }
        return true;
      }
      function changeStep(step, moveFocus = true) {
        if (!(form instanceof HTMLFormElement)) return;
        current = step;
        clearError();
        document.querySelectorAll('.form-step').forEach((x) => {
          if (x instanceof HTMLElement)
            x.hidden = Number(x.dataset.step) !== current;
        });
        document.querySelectorAll('[data-step-indicator]').forEach((x) => {
          if (!(x instanceof HTMLElement)) return;
          let n = Number(x.dataset.stepIndicator);
          x.classList.toggle('current', n === current);
          x.classList.toggle('finished', n < current);
          if (n === current) x.setAttribute('aria-current', 'step');
          else x.removeAttribute('aria-current');
        });
        previous.hidden = current === 1;
        next.hidden = current === 3;
        submit.hidden = current !== 3;
        if (moveFocus) {
          const heading = form.querySelector(`[data-step="${current}"] h3`);
          if (heading instanceof HTMLElement) {
            heading.tabIndex = -1;
            heading.focus({ preventScroll: true });
            heading.scrollIntoView({ block: 'start', behavior: 'instant' });
          }
        }
        if (current === 3) {
          const f = new FormData(form),
            s = form.querySelector('input[name="sacrament"]:checked');
          document.getElementById('review-box').innerHTML = '';
          const rows = [
            [
              'Sacramento',
              s?.closest('label')?.querySelector('strong')?.textContent || '',
            ],
            ['Participante', f.get('name')],
            ['Edad', f.get('age') + ' años'],
            ['Responsable', f.get('guardian')],
            ['Teléfono', f.get('phone')],
            ['Correo', f.get('email') || 'No indicado'],
          ];
          const box = document.getElementById('review-box');
          for (const [a, b] of rows) {
            const row = document.createElement('div');
            const name = document.createElement('span');
            const value = document.createElement('strong');
            name.textContent = String(a);
            value.textContent = String(b);
            row.append(name, value);
            box.append(row);
          }
        }
      }
      next.addEventListener('click', () => {
        clearError();
        if (validStep()) changeStep(current + 1);
      });
      previous.addEventListener('click', () => changeStep(current - 1));
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearError();
        if (current < 3) {
          if (validStep()) changeStep(current + 1);
          return;
        }
        if (submit.disabled || !validStep()) return;
        const f = new FormData(form);
        const consent = form.elements.namedItem('consent');
        const body = {
          ...Object.fromEntries(f.entries()),
          consent: consent instanceof HTMLInputElement && consent.checked,
        };
        submit.disabled = true;
        submit.textContent = 'Enviando...';
        try {
          const res = await fetch('/api/inscripciones', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          const data = await res.json();
          if (!res.ok) throw Error(data.error || 'Error al enviar');
          document.getElementById('receipt-code').textContent = data.code;
          form.hidden = true;
          const progress = document.querySelector('.wizard-progress');
          if (progress instanceof HTMLElement) progress.hidden = true;
          document.getElementById('success-card').hidden = false;
          document
            .getElementById('copy-code')
            .addEventListener('click', async () => {
              const button = document.getElementById('copy-code');
              try {
                await navigator.clipboard.writeText(data.code);
                button.textContent = '¡Copiado!';
              } catch {
                button.textContent =
                  'No se pudo copiar. Guarda el código mostrado arriba.';
              }
            });
          document.querySelector('.success-card').scrollIntoView({
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
              ? 'instant'
              : 'smooth',
            block: 'center',
          });
        } catch (err) {
          showError(err.message);
        } finally {
          submit.disabled = false;
          submit.textContent = 'Enviar solicitud ↗';
        }
      });
      changeStep(1, false);
    }
  </script>
</Layout>
