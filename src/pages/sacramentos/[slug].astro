---
import Eyebrow from '../../components/Eyebrow.astro';
import Heading from '../../components/Heading.astro';
import Action from '../../components/Action.astro';
import Layout from '../../components/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getAllContent } from '../../lib/db.js';
const { settings, sacramentos } = getAllContent();
const s = sacramentos.find((x) => x.id === Astro.params.slug);
if (!s) return Astro.redirect('/sacramentos');
---

<Layout settings={settings} title={s.title} description={s.description}>
  <section class="detail-hero">
    <div class="container detail-head">
      <Action href="/sacramentos" class="back-link">
        <Icon name="arrow-left" size={16} /> Volver a sacramentos
      </Action>
      <div class="detail-hero-grid">
        <div>
          <Eyebrow class="light" line>
            {s.tag}
          </Eyebrow>
          <Heading as="h1">{s.title}</Heading>
          <p>{s.description}</p>
          <div class="detail-hero-actions">
            <Action class="btn btn-gold" href={`/inscripcion?para=${s.id}`}>
              Iniciar preinscripción <Icon name="arrow-up-right" size={17} />
            </Action>
          </div>
        </div>
        <div class="detail-symbol">
          <Icon name={s.icon} size={108} stroke={0.9} />
          <span>✳</span>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container detail-body">
      <div class="detail-main" data-reveal>
        <Eyebrow line>SOBRE ESTE SACRAMENTO</Eyebrow>
        <Heading as="h2">
          Un paso en tu <em>camino de fe.</em>
        </Heading>
        <p class="long-copy">{s.detail}</p>
        <Heading as="h3">Orientación y requisitos</Heading>
        <p>
          La siguiente lista es orientativa y debe ser confirmada por la
          parroquia:
        </p>
        <div class="requirements">
          {s.requirements?.map((r, i) => (
            <div class="requirement">
              <span>{String(i + 1).padStart(2, '0')}</span>
              <p>{r}</p>
              <Icon name="check" size={18} />
            </div>
          ))}
        </div>
      </div>
      <aside class="detail-aside" data-reveal>
        <div class="aside-card">
          <span class="aside-top-icon">
            <Icon name="calendar" size={26} />
          </span>
          <Eyebrow>PREPARACIÓN</Eyebrow>
          <Heading as="h3">{s.duration}</Heading>
          <p>Pregunta en secretaría por fechas y grupos disponibles.</p>
          <hr />
          <Eyebrow>PREINSCRIPCIÓN</Eyebrow>
          <strong>
            {settings.registrationOpen && s.open
              ? 'Disponible'
              : 'Por habilitar'}
          </strong>
          <Action
            href={`/inscripcion?para=${s.id}`}
            class="btn btn-primary full-btn"
          >
            Ver formulario <Icon name="arrow-up-right" size={17} />
          </Action>
        </div>
        <div class="aside-help">
          <Icon name="phone" size={19} />
          <div>
            <strong>¿Tienes dudas?</strong>
            <p>Estamos aquí para ayudarte.</p>
            <Action href="/contacto">
              Ir a contacto <Icon name="arrow" size={14} />
            </Action>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>
