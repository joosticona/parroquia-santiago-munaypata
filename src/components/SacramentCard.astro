---
import Eyebrow from './Eyebrow.astro';
import Heading from './Heading.astro';
import Action from './Action.astro';
import Icon from './Icon.astro';
const { sacrament, index = 0 } = Astro.props;
---

<article class="sacrament-card" data-reveal style={`--stagger:${index * 85}ms`}>
  <div class="sacrament-card-head">
    <span class="sacrament-symbol">
      <Icon name={sacrament.icon} size={29} stroke={1.4} />
    </span>
    <span class="small-number">0{index + 1} / 04</span>
  </div>
  <div>
    <Eyebrow class="card-eyebrow">{sacrament.tag}</Eyebrow>
    <Heading as="h3">{sacrament.title}</Heading>
    <p>{sacrament.description}</p>
  </div>
  <Action
    href={`/sacramentos/${sacrament.id}`}
    class="round-link"
    aria-label={`Conocer ${sacrament.title}`}
  >
    <span>Conocer más</span>
    <span class="round-arrow">
      <Icon name="arrow-up-right" size={18} />
    </span>
  </Action>
</article>
