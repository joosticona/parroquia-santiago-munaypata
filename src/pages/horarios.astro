---
import ScheduleCard from '../components/ScheduleCard.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Heading from '../components/Heading.astro';
import Action from '../components/Action.astro';
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { getAllContent } from '../lib/db.js';
const { settings, horarios } = await getAllContent(Astro.locals.runtime?.env);
---

<Layout settings={settings} title="Horarios y celebraciones">
  <PageHero
    eyebrow="NOS ENCONTRAMOS EN COMUNIDAD"
    title="Horarios y celebraciones"
    description="La vida de fe se comparte. Aquí puedes consultar la programación disponible y cómo confirmar los horarios."
  />
  <section class="section">
    <div class="container">
      <div class="section-top" data-reveal>
        <div>
          <Eyebrow line>NUESTRA AGENDA</Eyebrow>
          <Heading as="h2">
            Nos vemos <em>en la parroquia.</em>
          </Heading>
        </div>
        <p class="section-aside">{settings.publicNotice}</p>
      </div>
      <div class="times-grid">
        {horarios.map((h, i) => (
          <ScheduleCard schedule={h} index={i} />
        ))}
      </div>
    </div>
  </section>
  <section class="section section-muted">
    <div class="container contact-banner" data-reveal>
      <div>
        <Eyebrow>SECRETARÍA PARROQUIAL</Eyebrow>
        <Heading as="h2">
          ¿Necesitas confirmar <em>un horario?</em>
        </Heading>
        <p>
          Atención: {settings.officeHours}. También puedes consultar por
          teléfono.
        </p>
      </div>
      <Action href="/contacto" class="btn btn-primary">
        Ver contacto <Icon name="arrow-up-right" size={19} />
      </Action>
    </div>
  </section>
</Layout>
