---
import Action from '../../components/Action.astro';
import Heading from '../../components/Heading.astro';
import Image from '../../components/Image.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import NavItem from '../../components/admin/NavItem.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../lib/auth.js';
import '../../styles/global.css';
if (!(await isAdmin(Astro))) return Astro.redirect('/admin/login');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#193e45" />
    <title>Centro de control · Apóstol Santiago</title>
    <link rel="stylesheet" href="/admin/admin.css" />
    <link rel="icon" href="/emblema.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-body">
    <a class="admin-skip-link" href="#admin-content">
      Saltar al contenido
    </a>
    <div class="admin-shell">
      <aside
        class="admin-sidebar"
        id="admin-sidebar"
        aria-label="Menú de administración"
      >
        <Action
          class="admin-sidebar-close"
          id="admin-menu-close"
          aria-label="Cerrar menú"
        >
          <Icon name="close" size={22} />
        </Action>
        <a href="/" class="admin-brand">
          <Image src="/emblema.svg" width="43" height="43" alt="" />
          <span>
            <strong>Apóstol Santiago</strong>
            <small>Centro de control</small>
          </span>
        </a>
        <p class="sidebar-label">GESTIÓN PARROQUIAL</p>
        <nav
          class="admin-menu"
          id="admin-menu"
          aria-label="Secciones administrativas"
        >
          <NavItem view="resumen" icon="layout-dashboard" selected>
            {' '}
            Resumen
          </NavItem>
          <NavItem view="solicitudes" icon="file-text">
            {' '}
            Inscripciones{' '}
            <span class="sidebar-count" id="sidebar-count">
              0
            </span>
          </NavItem>
          <NavItem view="sacramentos" icon="cross">
            {' '}
            Sacramentos
          </NavItem>
          <NavItem view="horarios" icon="clock">
            {' '}
            Horarios
          </NavItem>
          <NavItem view="avisos" icon="book-open">
            {' '}
            Avisos y noticias
          </NavItem>
          <NavItem view="eventos" icon="calendar">
            {' '}
            Eventos
          </NavItem>
          <NavItem view="galeria" icon="image">
            {' '}
            Galería
          </NavItem>
          <p class="sidebar-label second-label">CONFIGURACIÓN</p>
          <NavItem view="ajustes" icon="settings">
            {' '}
            Ajustes del sitio
          </NavItem>
        </nav>
        <div class="admin-sidebar-bottom">
          <a href="/" target="_blank" rel="noopener noreferrer">
            <Icon name="external-link" size={18} /> Ver sitio público
          </a>
          <Action id="admin-logout">
            <Icon name="logout" size={18} /> Cerrar sesión
          </Action>
        </div>
      </aside>
      <div class="admin-main">
        <header class="admin-topbar">
          <div class="admin-topbar-left">
            <Action
              id="admin-menu-toggle"
              class="admin-mobile-toggle"
              aria-label="Mostrar menú"
              aria-controls="admin-sidebar"
              aria-expanded="false"
            >
              <Icon name="menu" size={24} />
            </Action>
            <span class="admin-breadcrumb">
              PANEL / <strong id="active-view-name">RESUMEN</strong>
            </span>
          </div>
          <div class="admin-topbar-right">
            <span class="admin-live">
              <span></span> Panel activo
            </span>
            <div class="admin-avatar">AS</div>
          </div>
        </header>
        <main class="admin-content" id="admin-content" tabindex="-1">
          <div class="admin-page-head">
            <div>
              <Eyebrow>ADMINISTRACIÓN</Eyebrow>
              <Heading as="h1" id="admin-view-title" tabindex="-1">
                Bienvenido al <em>panel.</em>
              </Heading>
              <p id="admin-view-description">
                Gestiona la vida parroquial desde un solo lugar.
              </p>
            </div>
            <div class="admin-head-actions" id="admin-head-actions"></div>
          </div>
          <div id="admin-alert" class="admin-alert" hidden role="status"></div>
          <div id="admin-render" class="admin-render">
            <div class="admin-loading">
              Cargando la información parroquial...
            </div>
          </div>
        </main>
      </div>
    </div>
    <div id="admin-modal" class="admin-modal" hidden>
      <div class="modal-backdrop" data-close-modal></div>
      <div
        class="modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-heading"
        tabindex="-1"
      >
        <div class="modal-head">
          <div>
            <Eyebrow>EDITOR DE CONTENIDOS</Eyebrow>
            <Heading as="h2" id="modal-heading">
              Editar información
            </Heading>
          </div>
          <Action class="modal-close" data-close-modal aria-label="Cerrar">
            <Icon name="close" size={22} />
          </Action>
        </div>
        <form id="modal-form" class="modal-form">
          <div id="modal-fields" class="modal-fields"></div>
          <p class="form-feedback" id="modal-error" hidden role="alert"></p>
          <p class="upload-feedback" role="status" aria-live="polite"></p>
          <div class="modal-actions">
            <Action type="button" class="btn btn-secondary" data-close-modal>
              Cancelar
            </Action>
            <Action type="submit" class="btn btn-primary" id="modal-submit">
              Guardar cambios
            </Action>
          </div>
        </form>
      </div>
    </div>
    <script is:inline type="module" src="/admin.js"></script>
  </body>
</html>
