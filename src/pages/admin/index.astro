---
import Icon from '../../components/Icon.astro';
import {isAdmin} from '../../lib/auth.js';
import '../../styles/global.css';
if(!isAdmin(Astro))return Astro.redirect('/admin/login');
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#193e45"/><title>Centro de control · Apóstol Santiago</title><link rel="icon" href="/emblema.svg" type="image/svg+xml"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet"/></head>
<body class="admin-body"><div class="admin-shell">
<aside class="admin-sidebar" id="admin-sidebar"><a href="/" class="admin-brand"><img src="/emblema.svg" width="43" height="43" alt=""/><span><strong>Apóstol Santiago</strong><small>Centro de control</small></span></a><p class="sidebar-label">GESTIÓN PARROQUIAL</p><nav class="admin-menu" id="admin-menu" aria-label="Secciones administrativas">
<button data-view="resumen" class="selected"><Icon name="layout-dashboard" size={19}/> Resumen</button><button data-view="solicitudes"><Icon name="file-text" size={19}/> Inscripciones <span class="sidebar-count" id="sidebar-count">0</span></button><button data-view="sacramentos"><Icon name="cross" size={19}/> Sacramentos</button><button data-view="horarios"><Icon name="clock" size={19}/> Horarios</button><button data-view="avisos"><Icon name="book-open" size={19}/> Avisos y noticias</button><button data-view="eventos"><Icon name="calendar" size={19}/> Eventos</button><button data-view="galeria"><Icon name="image" size={19}/> Galería</button><p class="sidebar-label second-label">CONFIGURACIÓN</p><button data-view="ajustes"><Icon name="settings" size={19}/> Ajustes del sitio</button></nav>
<div class="admin-sidebar-bottom"><a href="/" target="_blank" rel="noopener noreferrer"><Icon name="external-link" size={18}/> Ver sitio público</a><button id="admin-logout"><Icon name="logout" size={18}/> Cerrar sesión</button></div></aside>
<div class="admin-main"><header class="admin-topbar"><div class="admin-topbar-left"><button id="admin-menu-toggle" class="admin-mobile-toggle" aria-label="Mostrar menú"><Icon name="menu" size={24}/></button><span class="admin-breadcrumb">PANEL / <strong id="active-view-name">RESUMEN</strong></span></div><div class="admin-topbar-right"><span class="admin-live"><span></span> Panel activo</span><div class="admin-avatar">AS</div></div></header>
<main class="admin-content"><div class="admin-page-head"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1 id="admin-view-title">Bienvenido al <em>panel.</em></h1><p id="admin-view-description">Gestiona la vida parroquial desde un solo lugar.</p></div><div class="admin-head-actions" id="admin-head-actions"></div></div><div id="admin-alert" class="admin-alert" hidden role="status"></div><div id="admin-render" class="admin-render"><div class="admin-loading">Cargando la información parroquial...</div></div></main>
</div></div>
<div id="admin-modal" class="admin-modal" hidden><div class="modal-backdrop" data-close-modal></div><div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-heading"><div class="modal-head"><div><p class="eyebrow">EDITOR DE CONTENIDOS</p><h2 id="modal-heading">Editar información</h2></div><button class="modal-close" data-close-modal aria-label="Cerrar"><Icon name="close" size={22}/></button></div><form id="modal-form" class="modal-form"><div id="modal-fields" class="modal-fields"></div><p class="form-feedback" id="modal-error" hidden role="alert"></p><div class="modal-actions"><button type="button" class="btn btn-secondary" data-close-modal>Cancelar</button><button type="submit" class="btn btn-primary" id="modal-submit">Guardar cambios</button></div></form></div></div>
<script is:inline src="/admin.js" defer></script>
</body></html>
