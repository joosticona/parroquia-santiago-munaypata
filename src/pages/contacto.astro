---
import ContactItem from '../components/ContactItem.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Heading from '../components/Heading.astro';
import Action from '../components/Action.astro';
import Image from '../components/Image.astro';
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { getContent } from '../lib/db.js';
const settings = getContent('settings');
const mapLink =
  'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent('Parroquia Apóstol Santiago Munaypata La Paz Bolivia');
---

<Layout settings={settings} title="Contacto">
  <PageHero
    eyebrow="TE DAMOS LA BIENVENIDA"
    title="Estamos para escucharte"
    description="Si tienes preguntas sobre sacramentos, catequesis o actividades, queremos orientarte."
  />
  <section class="section">
    <div class="container contact-grid">
      <div data-reveal>
        <Eyebrow line>VISÍTANOS</Eyebrow>
        <Heading as="h2">
          Siempre hay <em>un lugar para ti.</em>
        </Heading>
        <p class="long-copy">{settings.about}</p>
        <div class="contact-items">
          <ContactItem
            icon="pin"
            title="Encuéntranos"
            description={settings.address}
          />
          <ContactItem
            icon="phone"
            title="Llámanos"
            description={settings.phone}
          />
          <ContactItem
            icon="clock"
            title="Atención en secretaría"
            description={settings.officeHours}
          />
          {settings.email && (
            <ContactItem
              icon="mail"
              title="Correo electrónico"
              description={settings.email}
            />
          )}
        </div>
        <div class="contact-action-row">
          <Action
            class="btn btn-primary"
            href={settings.facebook}
            target="_blank"
            rel="noopener noreferrer"
          >
            Escríbenos en Facebook <Icon name="arrow-up-right" size={17} />
          </Action>
          <Action
            class="btn btn-secondary"
            href={mapLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            Cómo llegar <Icon name="pin" size={17} />
          </Action>
        </div>
      </div>
      <div class="contact-visual" data-reveal>
        <span class="contact-visual-label">MUNAYPATA · LA PAZ</span>
        <Image src="/templo-ilustracion.svg" alt="Ilustración de un templo" />
        <div class="contact-visual-bottom">
          <span>✳</span>
          <strong>Te esperamos con los brazos abiertos.</strong>
        </div>
      </div>
    </div>
  </section>
</Layout>
