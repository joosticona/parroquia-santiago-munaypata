---
import Heading from './Heading.astro';
import Action from './Action.astro';
import Image from './Image.astro';
import Icon from './Icon.astro';
const { settings } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-about">
      <Action class="footer-brand" href="/">
        <Image
          src={settings.logo || '/emblema.svg'}
          alt=""
          width="48"
          height="48"
        />{' '}
        <span>
          <strong>{settings.name}</strong>
          <small>{settings.subtitle}</small>
        </span>
      </Action>
      <p>
        Unidos por la fe, la esperanza y el servicio. Una comunidad para caminar
        juntos.
      </p>
      <Action
        class="footer-social"
        href={settings.facebook}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="facebook" size={18} /> Nuestra comunidad en Facebook{' '}
        <Icon name="arrow-up-right" size={14} />
      </Action>
    </div>
    <div>
      <Heading as="h4">Explorar</Heading>
      <Action href="/sacramentos">Nuestros sacramentos</Action>
      <Action href="/inscripcion">Preinscripciones</Action>
      <Action href="/consultar">Consultar mi solicitud</Action>
      <Action href="/vida-parroquial">Avisos y actividades</Action>
    </div>
    <div>
      <Heading as="h4">La parroquia</Heading>
      <Action href="/horarios">Horarios y celebraciones</Action>
      <Action href="/contacto">Cómo encontrarnos</Action>
      <Action
        href={settings.facebook}
        target="_blank"
        rel="noopener noreferrer"
      >
        Facebook oficial
      </Action>
      <Action href="/privacidad">Privacidad y datos</Action>
      <Action href="/admin/login">Acceso administrativo</Action>
    </div>
    <div>
      <Heading as="h4">Estamos cerca</Heading>
      <p class="footer-location">
        <Icon name="pin" size={18} />
        {settings.address}
      </p>
      <p class="footer-location">
        <Icon name="phone" size={18} />
        {settings.phone}
      </p>
      <Action class="footer-social" href="/contacto">
        Ver información de contacto <Icon name="arrow-up-right" size={15} />
      </Action>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>
      © {new Date().getFullYear()} Parroquia Apóstol Santiago · Munaypata.
    </span>
    <span>
      Hecho con fe, para nuestra comunidad <span class="star">✳</span>
    </span>
  </div>
</footer>
