---
import EmptyState from '../components/EmptyState.astro';
import NoticeCard from '../components/NoticeCard.astro';
import EventCard from '../components/EventCard.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Heading from '../components/Heading.astro';
import Image from '../components/Image.astro';
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getAllContent } from '../lib/db.js';
const { settings, avisos, eventos, galeria } = await getAllContent(
  Astro.locals.runtime?.env,
);
---

<Layout settings={settings} title="Vida parroquial">
  <PageHero
    eyebrow="COMPARTIMOS LA FE"
    title="Vida parroquial"
    description="Un espacio para descubrir nuestros avisos, celebraciones, encuentros y momentos que nos unen."
  />
  <section class="section">
    <div class="container">
      <div class="section-top" data-reveal>
        <div>
          <Eyebrow line>ÚLTIMAS NOVEDADES</Eyebrow>
          <Heading as="h2">
            Noticias que <em>nos acercan.</em>
          </Heading>
        </div>
      </div>
      <div class="notice-grid">
        {avisos.map((n) => (
          <NoticeCard notice={n} />
        ))}
        {avisos.length === 0 && (
          <EmptyState>Todavía no hay avisos publicados.</EmptyState>
        )}
      </div>
    </div>
  </section>
  <section class="section section-muted">
    <div class="container">
      <div class="section-top" data-reveal>
        <div>
          <Eyebrow line>PARTICIPA</Eyebrow>
          <Heading as="h2">
            Próximos <em>encuentros.</em>
          </Heading>
        </div>
      </div>
      <div class="event-grid">
        {eventos.map((e) => (
          <EventCard event={e} />
        ))}
        {eventos.length === 0 && (
          <EmptyState>
            Publicaremos los próximos encuentros muy pronto.
          </EmptyState>
        )}
      </div>
    </div>
  </section>
  {galeria.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-top">
          <div>
            <Eyebrow line>MOMENTOS COMPARTIDOS</Eyebrow>
            <Heading as="h2">
              Galería <em>comunitaria.</em>
            </Heading>
          </div>
        </div>
        <div class="gallery-grid">
          {galeria
            .filter((x) => x.image)
            .map((g) => (
              <figure data-reveal>
                <Image src={g.image} alt={g.title} loading="lazy" />
                <figcaption>{g.title}</figcaption>
              </figure>
            ))}
        </div>
      </div>
    </section>
  )}
</Layout>
